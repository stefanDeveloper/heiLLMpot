# Copy to .env and change every secret before deployment.

DB_NAME=honeypot_db
DB_USER=orchestrator_app
DB_PASSWORD=change-me

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRY_HOURS=168

# Used by scripts/gen_pki.sh for the orchestrator TLS certificate.
ORCHESTRATOR_CN=localhost

# Local host port bindings.
ORCHESTRATOR_API_PORT=8080
ORCHESTRATOR_HTTP_PORT=80
ORCHESTRATOR_HTTPS_PORT=443

# Optional local honeybot node profile.
NODE_ID=node-local-1
JWT_TOKEN=
HONEYPOT_ORCHESTRATOR_ENABLED=true
HONEYPOT_ENABLE_HTTPS=true
HONEYPOT_HTTP_PORT=8081
HONEYPOT_HTTPS_PORT=8443
HONEYPOT_SSH_ENABLED=false
HONEYPOT_SSH_PORT=2222
