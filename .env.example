# Copy to .env and change every secret before deployment.

DB_NAME=honeypot_db
DB_USER=orchestrator_app
DB_PASSWORD=change-me

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRY_HOURS=168

# Used by scripts/gen_pki.sh for the orchestrator TLS certificate.
ORCHESTRATOR_CN=localhost

# Local host port bindings.
ORCHESTRATOR_API_PORT=8080
ORCHESTRATOR_HTTP_PORT=80
ORCHESTRATOR_HTTPS_PORT=443

# Local dashboard for orchestrator telemetry.
DASHBOARD_PORT=8090
DASHBOARD_REFRESH_MS=4000
DASHBOARD_ROW_LIMIT=80
DASHBOARD_REDACT_SECRETS=true

# Optional local honeybot node profile.
NODE_ID=node-local-1
JWT_TOKEN=
HONEYPOT_ORCHESTRATOR_ENABLED=true
HONEYPOT_ENABLE_HTTPS=true
HONEYPOT_HTTP_PORT=8081
HONEYPOT_HTTPS_PORT=8443
HONEYPOT_SSH_ENABLED=false
HONEYPOT_SSH_PORT=2222

# ──────────────────────────────────────────────────────────────────────────────
# OpenTofu Deploy Secrets (TF_VAR_ variables are read by OpenTofu automatically)
# ──────────────────────────────────────────────────────────────────────────────
# Orchestrator API key used to register deployed honeybot nodes with the orchestrator.
TF_VAR_orchestrator_api_key=change-me-generate-with-openssl-rand-hex-32

# Database configuration for the deployed orchestrator stack
TF_VAR_db_name=honeypot_db
TF_VAR_db_user=orchestrator_app
TF_VAR_db_password=change-me-secure-db-password

# JWT key for orchestrator dashboard tokens
TF_VAR_jwt_secret=change-me-with-a-long-random-secret


